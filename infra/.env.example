# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=vizeye
POSTGRES_USER=vizeye
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# ── JWT — generate with: openssl rand -base64 48 ──────────────
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Agent ─────────────────────────────────────────────────────
AGENT_SECRET_SALT=CHANGE_ME_32_CHARS_SALT
AGENT_KEY=FILL_AFTER_FIRST_SEED

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vizeye.local

# ── URLs — change to your server IP or domain ────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=VizEye

# ── Ports ─────────────────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100
NEXT_TELEMETRY_DISABLED=1
